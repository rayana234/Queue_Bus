<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/background_light">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="@dimen/padding_screen_large">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="@dimen/top_bar_height"
            android:orientation="horizontal"
            android:gravity="center_vertical">

            <ImageView
                android:id="@+id/btnSettings"
                android:layout_width="@dimen/icon_size_top"
                android:layout_height="@dimen/icon_size_top"
                android:contentDescription="@string/desc_settings"
                android:src="@drawable/ic_settings" />

            <TextView
                android:id="@+id/txtStudentTitle"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:text="@string/student"
                android:textColor="@color/primary_text_blue"
                android:textSize="@dimen/text_size_header"
                android:textStyle="bold"
                android:gravity="center" />

            <ImageView
                android:id="@+id/btnNotifications"
                android:layout_width="@dimen/icon_size_top"
                android:layout_height="@dimen/icon_size_top"
                android:contentDescription="@string/desc_notifications"
                android:src="@drawable/ic_notification" />

            <ImageView
                android:id="@+id/btnProfile"
                android:layout_width="@dimen/icon_size_top"
                android:layout_height="@dimen/icon_size_top"
                android:layout_marginStart="@dimen/margin_medium"
                android:contentDescription="@string/desc_profile"
                android:src="@drawable/ic_profile" />

        </LinearLayout>

        <TextView
            android:id="@+id/txtDestination"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="@string/destination"
            android:textColor="@color/primary_text_blue"
            android:textSize="@dimen/text_size_title"
            android:textStyle="bold"
            android:layout_marginTop="@dimen/margin_large"
            android:layout_marginBottom="@dimen/margin_small" />

        <RadioGroup
            android:id="@+id/radioGroupDestination"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:layout_marginBottom="@dimen/margin_large">

            <RadioButton
                android:id="@+id/rb1"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="@string/university_to_parking"
                android:textSize="@dimen/text_size_message"
                android:textColor="@color/primary_text_blue" />

            <RadioButton
                android:id="@+id/rb2"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="@string/parking_to_university"
                android:textSize="@dimen/text_size_message"
                android:textColor="@color/primary_text_blue" />

        </RadioGroup>

        <TextView
            android:id="@+id/txtLiveOccupancy"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="@string/live_occupancy"
            android:textColor="@color/primary_text_blue"
            android:textSize="@dimen/text_size_title"
            android:textStyle="bold"
            android:gravity="center"
            android:layout_marginBottom="@dimen/margin_small" />

        <TextView
            android:id="@+id/txtOccupancy"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="@string/occupancy_format_preview"
            android:textColor="@color/status_green"
            android:textSize="@dimen/text_size_occupancy"
            android:textStyle="bold"
            android:gravity="center"
            android:layout_marginBottom="@dimen/margin_large" />

        <Button
            android:id="@+id/btnConfirmBooking"
            android:layout_width="match_parent"
            android:layout_height="@dimen/button_height"
            android:text="@string/confirm_booking_btn"
            android:textColor="@color/white"
            android:textSize="@dimen/text_size_button"
            android:backgroundTint="@color/green_confirm"
            android:layout_marginBottom="@dimen/margin_medium" />

        <Button
            android:id="@+id/btnCancelBooking"
            android:layout_width="match_parent"
            android:layout_height="@dimen/button_height"
            android:text="@string/cancel_booking"
            android:textColor="@color/white"
            android:textSize="@dimen/text_size_button"
            android:backgroundTint="@color/red_cancel"
            android:layout_marginBottom="@dimen/margin_large" />

        <TextView
            android:id="@+id/txtMessage"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:textColor="@color/gray_text"
            android:textSize="@dimen/text_size_message"
            android:visibility="gone" />

    </LinearLayout>
</ScrollView>